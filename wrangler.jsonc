{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "town-life-game",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  },
  "env": {
    "dev": {
      "name": "town-life-game-dev",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "dev.youichi.me",
          "custom_domain": true
        }
      ]
    }
  }
}
